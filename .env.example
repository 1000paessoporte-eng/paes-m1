# apps/api
DATABASE_URL=postgresql+psycopg://paes:paes@localhost:5432/paes_m1
SECRET_KEY=change-me
ENVIRONMENT=development

# Inicio de sesión con Google (opcional). Vacío = la API rechaza /auth/google
# y la web no muestra el botón; sigue funcionando el login con contraseña.
# Se obtiene en Google Cloud Console → APIs y servicios → Credenciales →
# ID de cliente de OAuth 2.0 (tipo "Aplicación web").
GOOGLE_CLIENT_ID=

# Pasarela de pago Flow (opcional). Vacías = el cobro queda apagado: la API
# rechaza /plan/pagar y /plan/trial, y la web no muestra ni el botón de compra
# ni la prueba gratis. Se sacan de flow.cl -> Mis datos -> Integraciones.
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Sandbox mientras se prueba; https://www.flow.cl/api para cobrar de verdad.
FLOW_BASE_URL=https://sandbox.flow.cl/api
# Plan de cobro recurrente, creado una sola vez por ambiente con
# `uv run python scripts/crear_plan_flow.py --crear` desde apps/api. Sin esto
# la prueba gratis queda apagada aunque haya credenciales: sin plan, suscribir
# falla DESPUÉS de que la persona entregó su tarjeta.
FLOW_PLAN_PRO_ID=
# Días de prueba antes del primer cobro. Es el número que se le manda a Flow y
# también el que muestra la web: sale de un solo lugar para que la pantalla no
# pueda prometer un plazo distinto del que se cobra.
TRIAL_DIAS=3
# Secreto del cron (recordatorios y reconciliación diaria de suscripciones).
# Vacío deja esos endpoints cerrados con 404.
CRON_SECRET=

# Correo saliente. Con SMTP_HOST vacío NO se manda nada: en desarrollo el
# mensaje queda en el log (cómodo), pero en producción eso significa que nadie
# puede recuperar su contraseña. Con Gmail: host smtp.gmail.com, puerto 587,
# usuario la cuenta completa y como contraseña una CONTRASEÑA DE APLICACIÓN
# (myaccount.google.com/apppasswords, exige verificación en dos pasos activa);
# la contraseña normal de la cuenta no sirve. Gmail reescribe el remitente si
# no coincide con la cuenta, así que SMTP_FROM debe usar esa misma dirección.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=1000paes <no-responder@1000paes.cl>
# Origen público del frontend: arma los enlaces que van dentro de los correos.
# En producción tiene que ser https://1000paes.cl o los links salen rotos.
FRONTEND_URL=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8000
# El MISMO client ID de arriba. Es público por diseño (viaja al navegador);
# el client secret NO se usa en este flujo y no debe ponerse aquí.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
